[Unit]
Description=Frontend Interview Telegram Bot
After=network.target

[Service]
Type=simple
User=www-data
WorkingDirectory=/var/www/frontend-interview-bot
ExecStart=/usr/bin/node /var/www/frontend-interview-bot/dist/bot.js
Restart=always
RestartSec=5
Environment=NODE_ENV=production
EnvironmentFile=/var/www/frontend-interview-bot/.env

[Install]
WantedBy=multi-user.target
