{
  "name": "frontend-interview-bot-mvp",
  "version": "1.0.0",
  "private": true,
  "description": "MVP Telegram bot for HTML/CSS interview prep",
  "main": "dist/bot.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/bot.js",
